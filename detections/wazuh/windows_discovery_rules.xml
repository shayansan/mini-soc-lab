<group name="local,windows,discovery,">

  <rule id="100101" level="5">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\whoami\.exe$</field>
    <description>Windows user discovery command executed: whoami</description>
    <mitre>
      <id>T1033</id>
    </mitre>
    <group>windows_discovery_sequence,discovery,windows,user_discovery,</group>
  </rule>

  <rule id="100102" level="5">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\ipconfig\.exe$</field>
    <description>Windows network configuration discovery command executed: ipconfig</description>
    <mitre>
      <id>T1016</id>
    </mitre>
    <group>windows_discovery_sequence,discovery,windows,network_discovery,</group>
  </rule>

  <rule id="100103" level="5">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\tasklist\.exe$</field>
    <description>Windows process discovery command executed: tasklist</description>
    <mitre>
      <id>T1057</id>
    </mitre>
    <group>windows_discovery_sequence,discovery,windows,process_discovery,</group>
  </rule>

  <rule id="100104" level="5">
    <if_sid>92033</if_sid>
    <description>Windows account discovery command observed</description>
    <group>windows_discovery_sequence,discovery,windows,account_discovery,</group>
  </rule>

  <rule id="100105" level="10" frequency="3" timeframe="30">
    <if_matched_group>windows_discovery_sequence</if_matched_group>
    <description>Possible Windows discovery sequence detected</description>
    <mitre>
      <id>T1033</id>
      <id>T1087</id>
      <id>T1016</id>
      <id>T1057</id>
    </mitre>
    <group>discovery,windows,correlation,</group>
  </rule>

</group>
